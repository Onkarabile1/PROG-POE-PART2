@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Organiser dashboard</h1>
    <a class="btn btn-primary" asp-controller="OrganiserEvents" asp-action="Create">+ New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body">
                <div class="rd-stat-number">@Model.TotalEvents</div>
                <div class="text-muted">Events created</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body">
                <div class="rd-stat-number">@Model.TotalEnrolments</div>
                <div class="text-muted">Total enrolments</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body">
                <div class="rd-stat-number">@Model.Upcoming.Count</div>
                <div class="text-muted">Upcoming events</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Events.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h5">You have not created any events yet</h2>
            <p class="text-muted">Create your first event to start taking enrolments.</p>
            <a class="btn btn-primary" asp-controller="OrganiserEvents" asp-action="Create">Create an event</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3">All events</h2>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Event</th>
                                    <th>Date</th>
                                    <th class="text-center">Enrolments</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in Model.Events.OrderByDescending(e => e.EventDate))
                                {
                                    <tr>
                                        <td>
                                            <strong>@ev.EventName</strong>
                                            <div class="small text-muted">@ev.EventType &middot; @ev.Distances</div>
                                        </td>
                                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-center"><span class="badge text-bg-dark">@(ev.EnrolmentCount ?? 0)</span></td>
                                        <td>
                                            @if (ev.IsUpcoming)
                                            {
                                                <span class="rd-status rd-status-confirmed">Upcoming</span>
                                            }
                                            else
                                            {
                                                <span class="rd-status rd-status-refunded">Completed</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">Enrolments</a>
                                            <a class="btn btn-sm btn-outline-primary" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@ev.EventId">Results</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Upcoming dates</h2>
                    @if (Model.Upcoming.Count == 0)
                    {
                        <p class="text-muted mb-0">No upcoming events.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var ev in Model.Upcoming)
                            {
                                var days = ev.EventDate.DayNumber - today.DayNumber;
                                <li class="list-group-item px-0">
                                    <strong>@ev.EventName</strong>
                                    <div class="small text-muted">
                                        @ev.EventDate.ToString("dd MMM yyyy") &middot;
                                        @(days == 0 ? "today" : days == 1 ? "tomorrow" : $"in {days} days")
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}