@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
    var categories = Model.Event.Categories ?? new List<CategoryResponse>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Categories</h1>
        <div class="text-muted">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@Model.Event.EventId">View enrolments</a>
        <a class="btn btn-outline-secondary" asp-controller="OrganiserEvents" asp-action="Index">Back to events</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Current categories</h2>

                @if (categories.Count == 0)
                {
                    <p class="text-muted mb-0">No categories yet. Add one using the form.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Distance</th>
                                    <th>Fee</th>
                                    <th>Limit</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in categories)
                                {
                                    <tr>
                                        <td><strong>@c.CategoryName</strong></td>
                                        <td>@c.DistanceKm.ToString("0.##") km</td>
                                        <td>R @c.EntryFee.ToString("N2")</td>
                                        <td>@c.MaxParticipants</td>
                                        <td class="text-end text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CategoryId">Edit</a>
                                            <form asp-action="Delete" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId"
                                                  method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this category?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Add a category</h2>
                <form asp-action="Create" method="post">
                    <partial name="_CategoryFields" model="Model.NewCategory" />
                    <button type="submit" class="btn btn-primary">Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}