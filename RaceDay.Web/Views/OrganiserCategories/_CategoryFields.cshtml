@model CategoryFormViewModel

<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="CategoryId" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" placeholder="e.g. 10 km, Under 18, Open" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="EntryFee" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StartPoint" class="form-label"></label>
        <input asp-for="StartPoint" class="form-control" />
        <span asp-validation-for="StartPoint" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EndPoint" class="form-label"></label>
        <input asp-for="EndPoint" class="form-control" />
        <span asp-validation-for="EndPoint" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="ElevationGainM" class="form-label"></label>
        <input asp-for="ElevationGainM" type="number" min="0" class="form-control" />
        <span asp-validation-for="ElevationGainM" class="text-danger"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="MapUrl" class="form-label"></label>
        <input asp-for="MapUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="MapUrl" class="text-danger"></span>
    </div>
</div>