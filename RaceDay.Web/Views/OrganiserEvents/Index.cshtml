@model List<EventResponse>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My events</h1>
    <a class="btn btn-primary" asp-action="Create">+ New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h5">No events yet</h2>
            <p class="text-muted">Create an event to get started.</p>
            <a class="btn btn-primary" asp-action="Create">Create an event</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Distances</th>
                            <th class="text-center">Enrolments</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@ev.EventName</strong>
                                    <div class="small text-muted">@ev.EventType</div>
                                </td>
                                <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@ev.Location</td>
                                <td>@ev.Distances</td>
                                <td class="text-center"><span class="badge text-bg-dark">@(ev.EnrolmentCount ?? 0)</span></td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@ev.EventId">Edit</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="OrganiserCategories" asp-action="Index" asp-route-eventId="@ev.EventId">Categories</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">Enrolments</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@ev.EventId">Results</a>
                                    <form asp-action="Delete" asp-route-id="@ev.EventId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}