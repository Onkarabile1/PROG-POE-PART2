@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@(Model.IsEdit ? "Edit event" : "Create an event")</h1>

               <form asp-action="@ViewData["Action"]" method="post" enctype="multipart/form-data">                   
               
                   <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="EventName" class="form-label"></label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" asp-items="@(new SelectList(FormOptions.EventTypes))" class="form-select">
                                <option value="">Choose...</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="date" class="form-control" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Province" class="form-label"></label>
                            <select asp-for="Province" asp-items="@(new SelectList(FormOptions.Provinces))" class="form-select">
                                <option value="">Choose...</option>
                            </select>
                            <span asp-validation-for="Province" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Venue" class="form-label"></label>
                        <input asp-for="Venue" class="form-control" />
                        <span asp-validation-for="Venue" class="text-danger"></span>
                    </div>

                    <p class="small text-muted">
                        The distances for an event are set by its categories (for example 5 km and 10 km).
                        You can add them as soon as the event is saved.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Event banner image</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                        {
                            <div class="mb-2"><img src="@Model.ExistingBannerUrl" class="rd-detail-banner" style="max-height:160px" alt="Current banner" /></div>
                        }
                        <input type="file" asp-for="Banner" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </form>
                    </div>
               
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}