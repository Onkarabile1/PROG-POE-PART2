@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">Join RaceDay</h1>
                <p class="text-muted">Create your account in a minute.</p>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label d-block">I want to</label>
                        <div class="btn-group w-100" role="group" aria-label="Account type">
                            <input type="radio" class="btn-check" asp-for="Role" id="roleParticipant" value="Participant" />
                            <label class="btn btn-outline-primary" for="roleParticipant">Enter races (Participant)</label>

                            <input type="radio" class="btn-check" asp-for="Role" id="roleOrganiser" value="Organiser" />
                            <label class="btn btn-outline-primary" for="roleOrganiser">Run events (Organiser)</label>
                        </div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">Phone (optional)</label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="mb-3" id="dobGroup">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>

                <p class="text-center mt-3 mb-0">
                    Already have an account? <a asp-action="Login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const dobGroup = document.getElementById('dobGroup');

        function updateRole() {
            const organiser = document.getElementById('roleOrganiser').checked;
            dobGroup.style.display = organiser ? 'none' : '';
        }

        document.querySelectorAll('input[name="Role"]').forEach(r => r.addEventListener('change', updateRole));
        updateRole();
    </script>
}