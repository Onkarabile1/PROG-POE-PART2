@model List<EnrolmentRow>
@{
    ViewData["Title"] = "My enrolments";
}

<h1 class="rd-page-title mb-3">My enrolments</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't enrolled in anything yet. <a asp-action="Events">Browse events</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle rd-table">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Fee</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var e = row.Enrolment;
                    <tr>
                        <td>@if (row.EventId != 0) {
                        <a asp-action="Details" asp-route-id="@row.EventId">@row.EventName</a>
                    } else
                    {

                        @row.EventName
                    }
    </td>
                    <td>@(row.EventDate?.ToString("d MMM yyyy") ?? "—")</td>
                    <td>@row.CategoryName</td>
                    <td>R@row.Fee.ToString("0.00")</td>
                    <td><span class="rd-status @e.StatusCss">@e.DisplayStatus</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            @if (e.CanPay)
                            {
                                <form asp-action="Pay" method="post" class="d-inline-flex gap-1">
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    <input type="hidden" name="amount" value="@row.Fee.ToString("0.00")" />
                                    <select name="method" class="form-select form-select-sm">
                                        <option>Card</option>
                                        <option>EFT</option>
                                    </select>
                                    <button class="btn btn-primary btn-sm" type="submit">Pay R@row.Fee.ToString("0.00")</button>
                                </form>
                            }
                            @if (e.CanCancel)
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Cancel</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}