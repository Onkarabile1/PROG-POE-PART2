@model BrowseViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<h1 class="rd-page-title mb-1">Upcoming events</h1>
<p class="text-muted mb-4">Find your next race and enrol in minutes.</p>

<form method="get" asp-action="Events" class="card rd-filter p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Event type</label>
            <select name="eventType" class="form-select">
                <option value="">All types</option>
                @foreach (var t in FormOptions.EventTypes)
                {
                    <option value="@t" selected="@(t == Model.EventType)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Province</label>
            <select name="province" class="form-select">
                <option value="">All provinces</option>
                @foreach (var p in FormOptions.Provinces)
                {
                    <option value="@p" selected="@(p == Model.Province)">@p</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Date</label>
            <input type="date" name="date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Filter</button>
            <a asp-action="Events" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">No upcoming events match your filters.</div>
}

<div class="row g-4">
    @foreach (var e in Model.Events)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card rd-event-card h-100">
               
            </div>
        </div>
    }
</div>