@model List<ResultRow>
@{
    ViewData["Title"] = "My results";
}

<h1 class="rd-page-title mb-3">My results</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">No published results yet. They'll appear here after your events.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle rd-table">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EventName</td>
                        <td>@(r.EventDate?.ToString("d MMM yyyy") ?? "—")</td>
                        <td>@r.CategoryName</td>
                        <td>@r.Result.FinishTimeText</td>
                        <td><strong>@r.PositionText</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}